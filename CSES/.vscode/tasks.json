{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++ Fast Run (input.in -> output.out)",
      "type": "shell",
      "command": "zsh",
      "args": [
        "-lc",
        "CXX=\"/opt/homebrew/opt/llvm/bin/clang++\"; if [[ ! -x \"$CXX\" ]]; then CXX=\"g++\"; fi; \"$CXX\" -O2 -std=c++20 -Wall -Wextra -Wshadow -I\"${workspaceFolder}\" \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\" < \"${workspaceFolder}/input.in\" > \"${workspaceFolder}/output.out\""
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    }
  ]
}
