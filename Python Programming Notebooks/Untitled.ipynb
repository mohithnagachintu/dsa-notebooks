    "n = int(input())\n",
    "i = 2\n",
    "while n>0:\n",
    "    f = [x for x in range(2,i+1) if i%x == 0 ]\n",
    "    if len(f)==1:\n",
    "        print(i)\n",
    "        n = n-1\n",
    "    i = i+1"
